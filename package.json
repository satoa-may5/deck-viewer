{
  "name": "deck-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local card collection & deck builder for a TCG, backed by a small Express server.",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:exe": "pkg . --targets node22-win-x64 --output dist/deck-viewer.exe"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jimp": "^1.6.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "nodemon": "^3.1.14"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "pool-exports/**/*",
      "tools/**/*"
    ]
  }
}

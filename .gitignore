.DS_Store
Thumbs.db
node_modules/
*.log
dist/
__pycache__/

# カード画像は著作権/サイズの都合でgit管理外にする(README参照)
images/*
!images/.gitkeep

# 個人のカードプール/デッキデータはgit管理外にする(公開リポジトリなので、他人の
# データではなく自分の使用データを載せたくない場合はここに追記する。クローン直後は
# server.js が空配列/空フォルダで自動初期化する)
data/cards.json
data/cardpools.json
data/decks/*
!data/decks/.gitkeep

# オリカメーカー(UA-maker)統合: materials一式は公式カードから切り出したと見られる
# 素材を含むため、著作権上publicリポジトリにも配布用exeにも含めない(ローカル限定
# 機能。詳細はCLAUDE.md参照)。npm run build:exe で配布用exeを作る前には
# public/oricard/ を必ず退避すること。
public/oricard/
oricard-source/

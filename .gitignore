.DS_Store
Thumbs.db
node_modules/
*.log
dist/
__pycache__/

# npm run build:exe がビルド中だけ data/ images/ を退避する先(ビルド完了時に
# 中身は元へ戻され、このフォルダ自体も消える。残っていたら異常終了した名残で、
# 次回ビルドの冒頭で自動的に復元される)
.build-stash/

# カード画像は著作権/サイズの都合でgit管理外にする(README参照)
images/*
!images/.gitkeep

# 個人のカードプール/デッキデータはgit管理外にする(公開リポジトリなので、他人の
# データではなく自分の使用データを載せたくない場合はここに追記する。クローン直後は
# server.js が空配列/空フォルダで自動初期化する)
data/cards.json
data/cardpools.json
data/decks/*
!data/decks/.gitkeep

# オリカメーカー(UA-maker)統合: 2026-08-19に著作権懸念からローカル限定にしていたが、
# 素材はユーザー本人が作成したものであることを確認し、公開リポジトリ・配布用exeにも
# 含める方針に変更した(詳細はCLAUDE.md参照)。public/oricard/(実際に使う一式)は
# 追跡対象。oricard-source/(materials.js再生成用の生素材フォルダ、pool-exports/と
# 同じ位置づけの作業用データ)は引き続きgit管理外。
oricard-source/

# pool-exports/ は配布ラインナップの`.dvpool`と`index.json`だけをgit管理する。
# その隣にある`<名前>/`(manifest.json + images/ の生データ。`.dvpool`を作り直す
# ときの元データ)は管理外(READMEにもそう書いてある)。ディレクトリだけを対象に
# するので`.dvpool`/`index.json`はそのまま追跡される。
pool-exports/*/
